{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PHP development server",
            "type": "process",
            "command": "C:\\xampp\\php\\php.exe",
            "args": [
                "-S",
                "127.0.0.1:8080"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "php-server",
                "pattern": {
                    "regexp": "^$",
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Development Server \\(http://127\\.0\\.0\\.1:8080\\) started",
                    "endsPattern": "^$"
                }
            }
        }
    ]
}
